    {
      "parameters": {
        "jsCode": "// Get all input items\nconst items = $input.all();\n\nlet allLeads = [];\n\n// Handle common aggregator structures safely\nfor (const item of items) {\n  const json = item.json;\n\n  if (Array.isArray(json)) {\n    // case: aggregated array directly in json\n    allLeads.push(...json);\n  } else if (Array.isArray(json.data)) {\n    // case: array under json.data\n    allLeads.push(...json.data);\n  } else if (typeof json === 'object' && Object.keys(json).length > 0) {\n    // case: single object\n    allLeads.push(json);\n  }\n}\n\n// Make sure we actually have leads\nif (allLeads.length === 0) {\n  return [{ json: { text: '⚠️ No leads found in input data.' } }];\n}\n\n// Build clean text output\nconst text = allLeads\n  .map((lead, i) => {\n    const name = lead[\"Name\"]?.trim() || \"N/A\";\n    const phone = lead[\"Phone Number\"]?.trim() || \"N/A\";\n    const email = lead[\"Email\"]?.trim() || \"N/A\";\n    const booked = lead[\"Date booked Oppointment\"] || \"N/A\";\n    const contacted = lead[\"Date contacted\"] || \"N/A\";\n    const timing = lead[\"Timing \"]?.trim() || \"N/A\";\n\n    return [\n      `Lead #${i + 1}`,\n      `Name: ${name}`,\n      `Phone Number: ${phone}`,\n      `Email: ${email}`,\n      `Date booked Appointment: ${booked}`,\n      `Date contacted: ${contacted}`,\n      `Timing: ${timing}`\n    ].join('\\n');\n  })\n  .join('\\n\\n');\n\n// Return formatted text\nreturn [{ json: { text } }];\n"
      },
